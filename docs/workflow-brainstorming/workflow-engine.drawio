        <mxCell id="edge-instance-state" value="durable correlation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="workflow-instance" target="state-store">
