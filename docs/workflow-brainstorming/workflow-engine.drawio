        <mxCell id="o-edge-claim-other-groups" value="other leases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="o1" source="o-group-claim" target="o-other-groups"><mxGeometry relative="1" as="geometry" /></mxCell>

