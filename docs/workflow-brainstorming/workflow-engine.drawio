          <mxGeometry x="1105" y="745" width="255" height="95" as="geometry" />
        </mxCell>
        <mxCell id="activity-note" value="Adapters implement one contract, but preserve their real interaction model. Messaging is event-driven; request-response and database calls usually complete immediately." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacing=8;fontSize=11;" vertex="1" parent="1">
